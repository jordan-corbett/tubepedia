doctype html

html(lang="en")

  head

    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")

    link(rel="stylesheet", href="/css/index.css")

    title TubePedia

  body 
    header
      .container.header-container
        .logo
          .logo-icon Icon
          .logo-text
            h1 TubePedia
            p London Underground Wiki

        nav
          ul
            li
              a(href="/")
                i.fas.fa-home Home
            li
              a(href="/history")
                i.fas.fa-history History
            li
              a(href="/departures")
                i.fas.fa-subway Live departures
            li
              a(href="map")
                i.fas.fa-map-marked-alt Interactive Tube Map
            li
              a(href="games-and-quizzes")
                i.fas.fa-gamepad Games & Quizzes
            li
              a(href="/lines-and-stations")
                i.fas.fa-database Lines & Stations
            li
              a(href="/about")
                i.fas.fa-info-circle About

        .mobile-menu
          i.fas.fa-bars

    section.hero 
      .container
        h2 Explore the London Underground
        p Discover the history and secrets of the world's oldest underground railway network
        .search-bar
          input(type="text", placeholder="Search for lines, stations, history...")
          button
            i.fas.fa-search Search

    section.features
      .container
        .section-title 
          h2 What You Can Explore
          p Dive into the rich history and interactive features of the London Underground

        .features-grid 
          .feature-card
            .feature-icon
              i.fas.fa-book 
            h3 London Underground Wiki
            p Comprehensive information on all tube lines, stations and facts.
            a.feature-link(href="/lines-and-stations") Explore Articles
              i.fas.fa-arrow-right 

          .feature-card
            .feature-icon
              i.fas.fa-history 
            h3 History
            p Explore the 150+ year history of the Underground with photos, timelines and fun facts.
            a.feature-link(href="/history") View Archive
              i.fas.fa-arrow-right

          .feature-card
            .feature-icon
              i.fas.fa-subway
            h3 Live Departures
            p View live departure information for any tube station.
            a.feature-link(href="/departures") Check Departures
              i.fas.fa-arrow-right

          .feature-card
            .feature-icon
              i.fas.fa-map
            h3 Interactive Tube Map
            p Explore the tube network with our interactive map.
            a.feature-link(href="/map") Open Map
              i.fas.fa-arrow-right

          .feature-card
            .feature-icon
              i.fas.fa-gamepad 
            h3 Games & Quizzes
            p Test your knowledge with tube trivia quizzes, station naming games, and interactive challenges.
            a.feature-link(href="/games-and-quizzes") Try Our Quizzes
              i.fas.fa-arrow-right

    section.tube-lines
      .container
        .section-title 
          h2 Explore all 11 London Underground lines

        .tube-lines-grid
          .tube-line
            .tube-line-icon B
            span.tube-line-text.bakerloo Bakerloo
          .tube-line
            .tube-line-icon C
            span.tube-line-text.central Central
          .tube-line
            .tube-line-icon C
            span.tube-line-text.circle Circle
          .tube-line
            .tube-line-icon D
            span.tube-line-text.district District
          .tube-line
            .tube-line-icon H
            span.tube-line-text.hammersmith Hammersmith & City
          .tube-line
            .tube-line-icon J
            span.tube-line-text.jubilee Jubilee
          .tube-line
            .tube-line-icon M
            span.tube-line-text.metropolitan Metropolitan
          .tube-line
            .tube-line-icon N
            span.tube-line-text.northern Northern
          .tube-line
            .tube-line-icon P
            span.tube-line-text.piccadilly Piccadilly
          .tube-line
            .tube-line-icon V
            span.tube-line-text.victoria Victoria
          .tube-line
            .tube-line-icon W
            span.tube-line-text.waterloo Waterloo & City

    footer
      .container
        .footer-content
          .footer-section
            h3 TubePedia
            p Your comprehensive guide to the London Underground

          .footer-section
            h3 Quick Links
            ul
              li
                a(href="#") Home
              li
                a(href="#") History
              li
                a(href="#") Live departures
              li
                a(href="#") Interactive Tube Map
              li
                a(href="#") Games & Quizzes
              li
                a(href="#") Lines & Stations
              li
                a(href="#") About

          .footer-section
            h3 Connect
            ul
              li
                a(href="#")
                  i.fab.fa-github GitHub Repository
              li
                a(href="#")
                  i.fas.fa-bug Report an Issue
              li
                a(href="#")
                  i.fas.fa-lightbulb Suggestions & Ideas
              li
                a(href="#")
                  i.fas.fa-envelope Contact

        .copyright
          p TubePedia &copy; 2025 - A Personal Project | This is a fan project and is not affiliated with Transport for London (TfL)