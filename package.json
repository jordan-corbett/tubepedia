{
  "name": "tubepedia",
  "version": "1.0.0",
  "description": "Encyclopedia of the London Underground",
  "main": "index.js",
  "scripts": {
    "build:ts": "tsc --watch",
    "build:sass": "sass --watch src/scss:public/css",
    "start:server": "nodemon dist/server.js",
    "dev": "concurrently \"npm run build:ts\" \"npm run build:sass\" \"npm run start:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordan-corbett/tubepedia.git"
  },
  "author": "Jordan Corbett",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jordan-corbett/tubepedia/issues"
  },
  "homepage": "https://github.com/jordan-corbett/tubepedia#readme",
  "dependencies": {
    "express": "^5.2.1",
    "pug": "^3.0.3",
    "sass": "^1.97.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
